<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="UCAHub: a study hub for Understanding Cyber-Aggression through AI Use, Trust, and Personality Factors.">
  <link rel="stylesheet" href="/assets/style.css">
  <script src="/assets/app.js" defer></script>
</head>
<body>
  <div id="preliveOverlay" aria-hidden="true"></div>

  <div class="container dim-wrap">
    <header class="header">
      <a class="brand" href="/">
        <div class="logo" aria-hidden="true"></div>
        <div>
          <h1 data-site-name>UCAHub</h1>
          <p data-tagline>Understanding Cyber-Aggression through AI Use, Trust, and Personality Factors</p>
        </div>
      </a>
      <nav class="nav" aria-label="Primary">
        <a href="/progress.html">Progress</a>
        <a href="/updates.html">Updates</a>
        <a href="/about.html">About</a>
        <a href="/ethics.html">Ethics</a>
        <a href="/contact.html">Contact</a>
      
        <button class="theme-toggle" id="themeToggle" type="button" aria-label="Theme toggle">
          <span class="theme-icon" aria-hidden="true"></span>
          <span data-theme-label>Dark</span>
        </button>
      
        <span class="font-controls" aria-label="Text size controls">
          <button class="fc-btn" id="fontDec" type="button" title="Smaller text">A−</button>
          <button class="fc-btn" id="fontReset" type="button" title="Reset text size">A</button>
          <button class="fc-btn" id="fontInc" type="button" title="Larger text">A+</button>
          <span class="fc-label" id="fontLabel">100%</span>
        </span>
      </nav>
    </header>

    <main>
      
<section class="top-metric" aria-label="Participation status">
  <div class="top-metric-inner">

    <div class="top-metric-left">
      <h2>Data received</h2>
      <p class="top-metric-note">
        This thermometer reflects responses collected (not overall project completion).
      </p>

      <!-- Thermometer markup remains unchanged -->
      <div id="thermometer"></div>

    </div>

    <div class="top-metric-right">
      <a class="poster-link" href="https://bit.ly/office-e24cn" target="_blank" rel="noopener">
        <img class="poster-img" src="/assets/ready-for-tomorrow.jpg" alt="ATU student research poster">
        <div class="poster-cta">Open survey link</div>
      </a>
    </div>

  </div>
</section>


</main>

    <footer class="footer">
      <span id="lastUpdated"></span>
      <div>UCAHub is a project progress hub. This site may remain in “pre-live” mode until Ethics approval.</div>
    </footer>
  </div>
</body>
</html>
